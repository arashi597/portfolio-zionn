<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Zion • Imperium Omnipotent Profile</title>

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

<style>
:root{
  --red-neon: #ff003c;
  --red-glow: rgba(255, 0, 60, 0.7);
  --purple-glow: #9d4edd;
  --bg-dark: #030305;
  --card-bg: rgba(8, 8, 14, 0.92);
  --border-glow: rgba(255, 0, 60, 0.5);
}

*{
  box-sizing: border-box;
  font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
}

body{
  margin:0;
  min-height:100vh;
  display:flex;
  flex-direction:column;
  align-items:center;
  color:#f1f5f9;
  background: var(--bg-dark);
  overflow-x:hidden;
  padding-bottom: 60px;
}

/* CYBER GRID & CONIC BACKGROUND */
body::before{
  content:"";
  position:fixed;
  inset:-50%;
  background: conic-gradient(from 180deg at 50% 50%, #ff003c 0deg, #7b2cbf 120deg, #000000 240deg, #ff003c 360deg);
  filter: blur(160px);
  opacity: .45;
  animation: spin 14s linear infinite;
  z-index: 0;
}

/* SCANLINE CRT EFFECT */
body::after{
  content:"";
  position:fixed;
  inset:0;
  background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.35) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.04), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.04));
  background-size: 100% 4px, 6px 100%;
  pointer-events: none;
  z-index: 10;
}

@keyframes spin{ 100%{ transform: rotate(360deg); } }

#stars{
  position: fixed;
  inset:0;
  z-index:1;
}

/* CONTAINER */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  max-width: 410px;
  z-index: 2;
  gap: 20px;
  margin-top: 20px;
  padding: 0 12px;
}

/* GLITCH WARNING TAPE */
.warning-banner {
  width: 100%;
  background: repeating-linear-gradient(
    -45deg,
    #ff003c,
    #ff003c 12px,
    #000 12px,
    #000 24px
  );
  color: #fff;
  font-weight: 900;
  font-size: 11px;
  letter-spacing: 2px;
  text-align: center;
  padding: 8px;
  text-transform: uppercase;
  box-shadow: 0 0 20px var(--red-neon);
  border-radius: 6px;
  border: 1px solid var(--red-neon);
  text-shadow: 0 0 8px #000;
  animation: pulseGlow 2s infinite alternate;
}

@keyframes pulseGlow {
  0% { box-shadow: 0 0 15px rgba(255,0,60,0.5); }
  100% { box-shadow: 0 0 30px rgba(255,0,60,0.9); }
}

/* MAIN RANTER CARD */
.card{
  width: 100%;
  background: var(--card-bg);
  backdrop-filter: blur(20px);
  border-radius: 18px;
  text-align: center;
  border: 1px solid var(--border-glow);
  box-shadow: 0 0 40px rgba(255, 0, 60, 0.3), inset 0 0 25px rgba(0, 0, 0, 0.95);
  overflow: hidden;
  padding-bottom: 22px;
  position: relative;
}

/* ANIMATED COVER CONTAINER */
.cover{
  height: 160px;
  background-color: #0b0010;
  background-image: linear-gradient(135deg, rgba(255, 0, 60, 0.45), rgba(0,0,0,0.85)), url('file_000000002568820683b0d01972fcae6d.png');
  background-size: cover;
  background-position: center;
  border-bottom: 2px solid var(--red-neon);
  position: relative;
  transition: all 0.3s ease;
}

.cover-hint {
  position: absolute;
  top: 10px;
  right: 10px;
  background: rgba(0,0,0,0.8);
  color: #fff;
  font-size: 9px;
  padding: 3px 8px;
  border-radius: 4px;
  border: 1px solid var(--red-neon);
  letter-spacing: 1px;
  font-weight: 800;
}

.profile{
  width: 120px;
  height: 120px;
  margin: -65px auto 8px;
  border-radius: 50%;
  position: relative;
  cursor: pointer;
}

.profile img{
  width: 100%;
  height: 100%;
  border-radius: 50%;
  object-fit: cover;
  border: 3px solid var(--red-neon);
  box-shadow: 0 0 30px var(--red-neon);
  background: #000;
}

.badge{
  position: absolute;
  bottom: 2px;
  right: -5px;
  background: var(--red-neon);
  color: #fff;
  padding: 4px 9px;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 1.5px;
  border-radius: 4px;
  text-transform: uppercase;
  box-shadow: 0 0 15px var(--red-neon);
}

.status-tag {
  display: inline-block;
  background: rgba(255, 0, 60, 0.25);
  color: #ff003c;
  border: 1px solid #ff003c;
  padding: 4px 16px;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 2px;
  border-radius: 4px;
  margin-bottom: 12px;
  text-transform: UPPERCASE;
  box-shadow: 0 0 18px rgba(255, 0, 60, 0.5);
}

.btn-group {
  display: flex;
  justify-content: center;
  gap: 10px;
  margin: 6px 0 14px;
}

button.upload-btn {
  padding: 8px 18px;
  border: 1px solid var(--red-neon);
  border-radius: 6px;
  background: rgba(255, 0, 60, 0.15);
  color: #fff;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 1.5px;
  cursor: pointer;
  transition: all 0.2s ease;
  text-transform: uppercase;
}

button.upload-btn:hover {
  background: var(--red-neon);
  box-shadow: 0 0 25px var(--red-neon);
  color: #000;
}

.name{
  font-size: 30px; 
  font-weight: 900; 
  letter-spacing: 4px; 
  text-transform: uppercase;
  text-shadow: 0 0 16px var(--red-neon);
}

.role{
  color: #d8b4fe;
  font-weight: 800; 
  font-size: 12px;
  letter-spacing: 2.5px;
  margin-top: 2px;
}

.tagline{
  color: #ff4d6d; 
  font-size: 12px; 
  font-weight: 800;
  letter-spacing: 2px;
  margin-top: 6px;
  text-transform: uppercase;
}

.bio{
  font-size: 13px;
  color: #f8fafc;
  margin: 12px 20px; 
  font-style: italic;
  background: rgba(0,0,0,0.8);
  padding: 10px;
  border-left: 3px solid var(--red-neon);
  border-right: 3px solid var(--red-neon);
  letter-spacing: 1px;
  box-shadow: inset 0 0 10px rgba(255,0,60,0.2);
}

/* STATS BAR */
.stats-bar {
  display: flex;
  justify-content: space-around;
  margin: 16px 15px 6px;
  padding: 12px 0;
  background: rgba(255, 0, 60, 0.08);
  border: 1px dashed rgba(255, 0, 60, 0.4);
  border-radius: 8px;
}

.stat-item {
  display: flex;
  flex-direction: column;
}

.stat-val {
  font-size: 17px;
  font-weight: 900;
  color: var(--red-neon);
  text-shadow: 0 0 10px var(--red-neon);
}

.stat-lbl {
  font-size: 9px;
  color: #a0aec0;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  font-weight: 700;
}

.socials {
  margin: 16px 0;
}

.socials a{
  color: #fff;
  margin: 0 12px;
  font-size: 22px;
  transition: all 0.2s;
}

.socials a:hover {
  color: var(--red-neon);
  text-shadow: 0 0 15px var(--red-neon);
  transform: scale(1.15);
}

.links a{
  display: inline-block;
  margin: 4px;
  padding: 7px 16px;
  background: rgba(255, 255, 255, 0.05);
  color: #fff;
  border-radius: 6px;
  border: 1px solid rgba(255, 255, 255, 0.18);
  text-decoration: none;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1px;
  transition: 0.2s;
}

.links a:hover {
  border-color: var(--red-neon);
  color: var(--red-neon);
  box-shadow: 0 0 12px rgba(255, 0, 60, 0.4);
  background: rgba(255, 0, 60, 0.1);
}

.clock{
  font-size: 11px;
  color: #94a3b8; 
  margin-top: 14px;
  letter-spacing: 2px;
  font-weight: 800;
}

/* BOX SECTIONS */
.section-box {
  width: 100%;
  background: var(--card-bg);
  backdrop-filter: blur(20px);
  border-radius: 16px;
  padding: 18px;
  border: 1px solid var(--border-glow);
  box-shadow: inset 0 0 15px rgba(0,0,0,0.9), 0 0 20px rgba(0,0,0,0.5);
}

.section-box h3 {
  margin-top: 0;
  margin-bottom: 12px;
  font-size: 13px;
  color: var(--red-neon);
  text-transform: uppercase;
  letter-spacing: 2.5px;
  font-weight: 900;
  display: flex;
  align-items: center;
  gap: 8px;
}

.scroll-list {
  max-height: 230px;
  overflow-y: auto;
  padding: 10px 14px;
  background: rgba(0, 0, 0, 0.85);
  border-radius: 8px;
  font-size: 12px;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.scroll-list div {
  padding: 7px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  color: #e2e8f0;
  font-weight: 600;
  transition: color 0.2s;
}

.scroll-list div:hover {
  color: var(--red-neon);
}

.scroll-list div:last-child {
  border-bottom: none;
}

/* FORTE STYLING */
.forte-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.forte-item {
  background: rgba(0, 0, 0, 0.85);
  padding: 10px 14px;
  border-radius: 6px;
  font-size: 12px;
  display: flex;
  justify-content: space-between;
  border-left: 4px solid var(--red-neon);
  font-weight: 800;
}

.forte-tag {
  color: #22c55e;
  font-weight: 900;
  letter-spacing: 1.5px;
}

/* AUDIO VISUALIZER BARS */
.visualizer {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 3px;
  height: 20px;
  margin-bottom: 8px;
}

.v-bar {
  width: 4px;
  background: var(--red-neon);
  height: 100%;
  border-radius: 2px;
  animation: equalize 1.2s infinite ease-in-out alternate;
}

.v-bar:nth-child(2) { animation-delay: -0.4s; }
.v-bar:nth-child(3) { animation-delay: -0.2s; }
.v-bar:nth-child(4) { animation-delay: -0.6s; }
.v-bar:nth-child(5) { animation-delay: -0.8s; }

@keyframes equalize {
  0% { height: 15%; }
  100% { height: 100%; }
}

/* SPOTIFY EMBED CONTAINER */
.spotify-box {
  width: 100%;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 0 20px rgba(29, 185, 84, 0.25);
}

.spotify-select {
  width: 100%;
  padding: 9px 12px;
  background: #090d16;
  color: #fff;
  border: 1px solid var(--border-glow);
  border-radius: 8px;
  margin-bottom: 10px;
  font-size: 12px;
  outline: none;
  font-weight: 800;
}

.footer {
  margin-top: 15px;
  font-size: 11px;
  color: #64748b;
  text-align: center;
  letter-spacing: 2px;
  text-transform: uppercase;
  font-weight: 900;
}
</style>
</head>

<body>

<canvas id="stars"></canvas>

<div class="container">

  <div class="warning-banner">⚡ DOMAIN CONTROLLED • DO NOT ENGAGE ⚡</div>

  <!-- MAIN PROFILE CARD -->
  <div class="card">
    
    <!-- ANIMATED COVER PHOTO (GIF / BANNER) -->
    <div class="cover" id="cover">
      <span class="cover-hint"><i class="fas fa-film"></i> ANIMATED BANNER</span>
    </div>

    <!-- AVATAR PHOTO -->
    <div class="profile">
      <img id="avatar" src="333a080b36b10577ea8550cac7cb2b8f.jpg" alt="Avatar">
      <div class="badge">ZION GOD</div>
    </div>

    <div class="status-tag">⚡ NERFED • RETIRED</div>

    <div class="btn-group">
      <button class="upload-btn" onclick="upload.click()"><i class="fas fa-camera"></i> Change Photo</button>
      <button class="upload-btn" onclick="coverUpload.click()"><i class="fas fa-image"></i> Change Cover</button>
    </div>

    <!-- HIDDEN FILE INPUTS FOR LIVE PREVIEWS -->
    <input type="file" id="upload" accept="image/*" hidden>
    <input type="file" id="coverUpload" accept="image/*,.gif" hidden>

    <div id="greet" style="font-size:11px; color:#94a3b8; font-weight:800; letter-spacing:1.5px;"></div>

    <div class="name">Zion</div>
    <div class="role">ZION • UNTOUCHABLE DEVELOPER</div>

    <div class="bio">"quit muna"</div>

    <div class="tagline">Create your own reality.</div>

    <!-- EXPANDED STATS TRACKER -->
    <div class="stats-bar">
      <div class="stat-item">
        <span class="stat-val">99%</span>
        <span class="stat-lbl">Win Rate</span>
      </div>
      <div class="stat-item">
        <span class="stat-val">∞</span>
        <span class="stat-lbl">Smoke</span>
      </div>
      <div class="stat-item">
        <span class="stat-val">#1</span>
        <span class="stat-lbl">Entity</span>
      </div>
      <div class="stat-item">
        <span class="stat-val">MAX</span>
        <span class="stat-lbl">Domain</span>
      </div>
    </div>

    <div class="socials">
      <a href="https://github.com/arashi597" target="_blank"><i class="fab fa-github"></i></a>
      <a href="https://www.facebook.com/share/1Cv7Q153bW/" target="_blank"><i class="fab fa-facebook"></i></a>
      <a href="https://www.instagram.com/zion_on_top?igsh=MTdqanB2ZG1yb3V6" target="_blank"><i class="fab fa-instagram"></i></a>
    </div>

    <div class="links">
      <a href="https://github.com/arashi597" target="_blank">GitHub</a>
      <a href="https://www.facebook.com/share/1Cv7Q153bW/" target="_blank">Facebook</a>
      <a href="https://www.instagram.com/zion_on_top?igsh=MTdqanB2ZG1yb3V6" target="_blank">Instagram</a>
    </div>

    <div class="clock" id="clock"></div>
  </div>

  <!-- SPOTIFY EMBEDDED PLAYER WITH VISUALIZER -->
  <div class="section-box">
    <h3>
      <i class="fab fa-spotify" style="color:#1db954;"></i> Spotify Track
    </h3>

    <div class="visualizer">
      <div class="v-bar"></div>
      <div class="v-bar"></div>
      <div class="v-bar"></div>
      <div class="v-bar"></div>
      <div class="v-bar"></div>
    </div>

    <select class="spotify-select" id="spotifySelect" onchange="changeSpotifyTrack(this.value)">
      <option value="4PTG3326XR32A3C32A132">Chase Atlantic - SWIM</option>
      <option value="1Bxfay2M21P1223414">Cigarettes After Sex - Apocalypse</option>
      <option value="0e8G1FfX76e5y02143">Phonk / Jujutsu Theme</option>
    </select>
    
    <div class="spotify-box">
      <iframe id="spotifyIframe" 
              style="border-radius:12px" 
              src="https://open.spotify.com/embed/track/4PTG3326XR32A3C32A132?utm_source=generator&theme=0" 
              width="100%" 
              height="152" 
              frameBorder="0" 
              allowfullscreen="" 
              allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" 
              loading="lazy">
      </iframe>
    </div>
  </div>

  <!-- FIRST NAMES ALIASES -->
  <div class="section-box">
    <h3><i class="fas fa-crown"></i> First Names / Aliases</h3>
    <div class="scroll-list" id="first-names"></div>
  </div>

  <!-- FORTE -->
  <div class="section-box">
    <h3><i class="fas fa-fist-raised"></i> Forte / Specialization</h3>
    <div class="forte-list">
      <div class="forte-item"><span>e.d</span> <span class="forte-tag">MAIN</span></div>
      <div class="forte-item"><span>a.r</span> <span style="color:#64748b;">hindi masyado</span></div>
      <div class="forte-item"><span>ptt</span> <span class="forte-tag">ACTIVE</span></div>
      <div class="forte-item"><span>debate</span> <span class="forte-tag">EXPERT</span></div>
      <div class="forte-item"><span>r.t</span> <span style="color:#64748b;">hindi masyado</span></div>
    </div>
  </div>

  <!-- FOOTER -->
  <div class="footer">
    © 2026 Zion • All Rights Reserved
  </div>

</div>

<script>
/* AVATAR & COVER UPLOADS WITH LIVE PREVIEW */
const avatar = document.getElementById("avatar");
const upload = document.getElementById("upload");
const cover = document.getElementById("cover");
const coverUpload = document.getElementById("coverUpload");

upload.addEventListener("change", function(e) {
  const file = e.target.files[0];
  if (file) {
    const reader = new FileReader();
    reader.onload = function(evt) {
      avatar.src = evt.target.result;
    };
    reader.readAsDataURL(file);
  }
});

coverUpload.addEventListener("change", function(e) {
  const file = e.target.files[0];
  if (file) {
    const reader = new FileReader();
    reader.onload = function(evt) {
      cover.style.backgroundImage = `url('${evt.target.result}')`;
    };
    reader.readAsDataURL(file);
  }
});

/* SPOTIFY TRACK CHANGERS */
function changeSpotifyTrack(trackId) {
  const iframe = document.getElementById("spotifyIframe");
  iframe.src = `https://open.spotify.com/embed/track/${trackId}?utm_source=generator&theme=0`;
}

/* GREETING */
function greet(){
  let h = new Date().getHours();
  if(h < 12) return "GOOD MORNING ☀️";
  if(h < 18) return "GOOD AFTERNOON 🌤️";
  return "GOOD EVENING 🌙";
}
document.getElementById("greet").innerText = greet();

/* REAL TIME CLOCK */
setInterval(() => {
  document.getElementById("clock").innerText = new Date().toLocaleTimeString();
}, 1000);

/* FIRST NAMES DATA */
const firstNames = [
  "Theultimate Zion Omnipotence", "RK Keshi Imperium Aeternum", "VG Asta",
  "Softboy Tokito", "Zeyon Tenshikahe", "Winz Unli Puyat", "Sasuke X. Uchiha",
  "Raikou Schadenfreude", "Kirsch Indestructible Strength", "Zhin Xiao Rang",
  "Zion Sheningenan", "Aizen Undefeated", "Akari Nambubugbog",
  "Keshi Indestructible Strength", "Winz Euz-Hussein", "Xenshi W. Revolution",
  "Softboy Trent", "Xenshi Straycatlover", "Theultimate Ashura Indestructible Strength",
  "Zion Indomitable Triumphant", "Akiro Naka-God Mode", "Minato Naka-Hokage Mode",
  "Ryker Faiyaz", "WS Keshi Indestructible Strength", "WS Saint Indestructible Strength",
  "Kirsch Young Thugz", "Zero Young Thugz", "Zeno Artificial Intelligence",
  "Shin Lantero", "Raiden Unslain", "Nanang Nevernatulog", "Nanang Galit Kay Meta",
  "Resh Cove", "Sixth Artificial", "Theultimate Zion Endless Strength",
  "Zeref Zoldyck", "Zhin Machiavelli", "Muichiro Strongest Being", "Raii Sakamoto",
  "Shin Untouchable Entity", "Theultimate Kyrion Indestructible Strength",
  "VG Yami", "Shin Cataclysm", "Kirsch Omnipotent Will", "Ichigo Naka-God Mode",
  "Raii W. Revolution", "Xiena Manhater", "Aurelius Artificial", "Og Zion",
  "Karina Intellectual", "Ashura unbeatable strength", "Raii Slipknot",
  "Raiden I.s", "RK Winter Cataclysm", "Seven Artificial", "Shawn Heartfilia",
  "Raii Pumapatayngbobo", "OG Keshi", "Winter Landeza", "Zin Conquer",
  "Theultimate Keshi Inexorable Divinity"
];

document.getElementById("first-names").innerHTML =
  firstNames.map(f => `<div>${f}</div>`).join("");

/* BACKGROUND ANIMATED STARS */
const c = stars.getContext("2d");
stars.width = innerWidth;
stars.height = innerHeight;

let s = [...Array(100)].map(() => ({
  x: Math.random() * innerWidth,
  y: Math.random() * innerHeight,
  r: Math.random() * 1.5
}));

function anim() {
  c.clearRect(0, 0, stars.width, stars.height);
  c.fillStyle = "#ff003c";
  s.forEach(p => {
    c.beginPath();
    c.arc(p.x, p.y, p.r, 0, Math.PI * 2);
    c.fill();
    p.y += 0.8;
    if (p.y > stars.height) p.y = 0;
  });
  requestAnimationFrame(anim);
}
anim();
</script>

</body>
</html>
